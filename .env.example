# Copy this file to .env and fill in every value. Never commit .env.

# Time zone of the NAS, as a tz database name, for example Europe/Paris.
TZ=

# User and group ids the services run as. On Linux, run `id` to get yours (often 1000). On Windows with Docker Desktop, use 1000.
PUID=
PGID=

# Absolute path of the data root, outside the repo. It holds the torrents tree and the media tree (movies, shows, anime, music, books, manga). Use forward slashes, for example D:/nas/data on Windows or /srv/nas/data on Linux.
DATA_ROOT=

# Absolute path of the appdata root, outside the repo. Each service keeps its database and settings in its own folder here. Same format as DATA_ROOT.
APPDATA_ROOT=

# Port of the Jellyfin web UI on the local network. Leave empty to use 8096.
JELLYFIN_PORT=

# DuckDNS subdomain that points to the NAS, without .duckdns.org. For example myname for myname.duckdns.org.
DUCKDNS_SUBDOMAIN=

# DuckDNS token, shown at the top of duckdns.org once logged in. Treat it as a password.
DUCKDNS_TOKEN=

# Public hostname of Jellyfin, served by Caddy over HTTPS. DuckDNS resolves any name under your subdomain. Write jellyfin.${DUCKDNS_SUBDOMAIN}.duckdns.org to reuse the subdomain set above.
JELLYFIN_HOSTNAME=

# Port of the Seerr web UI on the local network. Leave empty to use 5055.
SEERR_PORT=

# Public hostname of Seerr, served by Caddy over HTTPS. Write seerr.${DUCKDNS_SUBDOMAIN}.duckdns.org to reuse the subdomain.
SEERR_HOSTNAME=

# HTTPS port Friends use to reach Caddy, forwarded by the router with the same number. Leave empty to use 443. A high port no service uses by default draws fewer scans.
CADDY_HTTPS_PORT=

# Port of the qBittorrent web UI on the local network, published by Gluetun since qBittorrent shares its network. Leave empty to use 8080.
QBITTORRENT_PORT=

# VPN that every torrent goes through. Leave all VPN values empty until you choose a provider: Gluetun then keeps the tunnel down and qBittorrent has no connectivity. Provider name as listed by Gluetun, for example protonvpn or mullvad.
VPN_SERVICE_PROVIDER=

# VPN protocol, wireguard or openvpn. Leave empty to use openvpn.
VPN_TYPE=

# OpenVPN username and password, given by the provider for manual setups. Not your website login with most providers. Treat the password as a password.
OPENVPN_USER=
OPENVPN_PASSWORD=

# WireGuard private key and interface address, taken from a WireGuard config file generated by the provider. Treat the key as a password.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=

# Comma separated countries of the VPN servers to use, for example Netherlands,Switzerland. Leave empty to let Gluetun pick.
SERVER_COUNTRIES=
