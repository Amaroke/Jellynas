# Copy this file to .env and fill in every value. Never commit .env.

# Base

# Time zone of the NAS, as a tz database name, for example Europe/Paris.
TZ=

# User and group ids the services run as. On TrueNAS, use 568, the apps user. On another Linux host, run `id` to get yours (often 1000).
PUID=
PGID=

# Absolute path of the data root, outside the repo. It holds the torrents tree and the media tree (movies, shows, anime, music, books, manga). For example /mnt/tank/data on TrueNAS or /srv/nas/data on another Linux host.
DATA_ROOT=

# Absolute path of the appdata root, outside the repo. Each service keeps its database and settings in its own folder here. Same format as DATA_ROOT.
APPDATA_ROOT=

# Absolute path where the backup service writes a nightly archive of the appdata root, kept 30 days. Keep it on another dataset than DATA_ROOT and APPDATA_ROOT, for example /mnt/tank/backup on TrueNAS.
BACKUP_ROOT=

# Domain, optional with the caddy service

# Domain of the NAS, its DNS zone hosted by OVH. Friends reach jellyfin.<DOMAIN> and seerr.<DOMAIN>, the Admin reaches each tool at <tool>.lan.<DOMAIN> from the local network only.
DOMAIN=

# Local network allowed to reach the lan names, in CIDR notation, for example 192.168.1.0/24. Caddy refuses any other source.
LAN_SUBNET=

# OVH API endpoint of the account that holds the zone. Leave empty to use ovh-eu.
OVH_ENDPOINT=

# OVH API keys Caddy uses to obtain the certificates and to keep jellyfin and seerr on the public IP, created at https://eu.api.ovh.com/createToken/ with rights on the records of the zone only. Treat them as passwords.
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# HTTPS port of Caddy, the only port the NAS publishes, forwarded by the router with the same number. Leave empty to use 443. A high port no service uses by default draws fewer scans.
CADDY_HTTPS_PORT=

# VPN, optional with the gluetun service

# VPN that every torrent goes through. Leave all VPN values empty until you choose a provider: Gluetun then keeps the tunnel down and qBittorrent has no connectivity. Provider name as listed by Gluetun, for example airvpn, protonvpn or mullvad.
VPN_SERVICE_PROVIDER=

# VPN protocol, wireguard or openvpn. Leave empty to use openvpn.
VPN_TYPE=

# OpenVPN username and password, given by the provider for manual setups. Not your website login with most providers. Treat the password as a password.
OPENVPN_USER=
OPENVPN_PASSWORD=

# WireGuard private key, preshared key and interface address, taken from a WireGuard config file generated by the provider. Only some providers, such as AirVPN, give a preshared key. Keep only the IPv4 address. Treat both keys as passwords.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=

# Comma separated countries of the VPN servers to use, for example Netherlands,Switzerland. Leave empty to let Gluetun pick.
SERVER_COUNTRIES=

# Comma separated regions of the VPN servers to use, for example Europe with AirVPN. Wider than countries. Leave empty to let Gluetun pick.
SERVER_REGIONS=

# Ports the VPN provider forwards to you, comma separated, so that peers can connect in. The first one is for qBittorrent, the second one for slskd. Leave empty if your provider gives none.
VPN_FORWARDED_PORT=

# Port slskd listens on for other Soulseek users, the second port of VPN_FORWARDED_PORT. Leave empty to use 50300, which nobody can reach through the VPN.
SLSKD_LISTEN_PORT=

# API key Homepage sends to the control server of Gluetun to read the public IP and the country of the VPN, its only access. Letters and digits only. Generate one with: openssl rand -hex 24. Leave empty to keep the control server closed. Treat it as a password.
GLUETUN_API_KEY=

# Automation

# qBittorrent login that cross-seed and ratio use to talk to qBittorrent, the one set in Tools > Options > WebUI. Treat the password as a password.
QBITTORRENT_USER=
QBITTORRENT_PASSWORD=

# API keys copied from Settings > General > Security in Radarr, Sonarr, Lidarr and Prowlarr. Recyclarr, Tdarr and cross-seed use the Radarr and Sonarr ones, cross-seed and ratio the Prowlarr one, Homepage all of them. Treat them as passwords.
RADARR_API_KEY=
SONARR_API_KEY=
LIDARR_API_KEY=
PROWLARR_API_KEY=

# Soulseek account slskd connects with. slskd creates it at its first login if the username is free. Pick a username that does not identify you. Treat the password as a password.
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=

# Login of the slskd web UI. Treat the password as a password.
SLSKD_USERNAME=
SLSKD_PASSWORD=

# API key Lidarr, through Tubifarry, and Homepage use to talk to slskd, at least 16 characters. Generate one with: openssl rand -hex 24. Treat it as a password.
SLSKD_API_KEY=

# Login of the Suwayomi web UI, which Homepage also uses. Letters and digits only, since Homepage reads them. Treat the password as a password.
SUWAYOMI_USERNAME=
SUWAYOMI_PASSWORD=

# API key the Tdarr node uses to talk to the Tdarr server. It is also the first password of the Tdarr admin login, so set it before the first start. It starts with tapi_ followed by at least 10 letters, digits or underscores. Generate one with: echo "tapi_$(openssl rand -hex 16)". Treat it as a password.
TDARR_API_KEY=

# Login of the admin account of the Indexarr web UI. Treat the password as a password.
INDEXARR_USERNAME=
INDEXARR_PASSWORD=

# Secret Indexarr signs its login sessions with, so they last across restarts. Generate one with: openssl rand -hex 32. Treat it as a password.
INDEXARR_SESSION_SECRET=

# API keys Indexarr fetches the details of the works with, beyond what Radarr and Sonarr give it, such as the episode count of each season: the "API Key" of https://www.themoviedb.org/settings/api, not the read access token, and a key of https://thetvdb.com/api-information. Leave empty to rely on Radarr and Sonarr only. Treat them as passwords.
TMDB_API_KEY=
TVDB_API_KEY=

# Music bot, optional with the music-bot service

# Token of the Discord bot the music bot signs in as, from Bot > Reset Token of its application at https://discord.com/developers/applications. Treat it as a password.
DISCORD_TOKEN=

# Id of the Discord server the music bot answers on, copied with Copy Server ID once the developer mode of Discord is on.
DISCORD_GUILD_ID=

# API key the music bot searches Jellyfin with, created in Jellyfin, Dashboard > API Keys. Treat it as a password.
MUSIC_BOT_JELLYFIN_API_KEY=

# Private tracker, optional with the cross-seed, autobrr and ratio services

# API key that protects the cross-seed API, at least 24 characters. Generate one with: openssl rand -hex 24. Treat it as a password.
CROSS_SEED_API_KEY=

# Comma separated ids of the Prowlarr indexers cross-seed searches, private trackers only, for example 3,7. The id is the number in the Torznab URL that Prowlarr shows for each indexer.
CROSS_SEED_INDEXER_IDS=

# Disk budget of the Farm, the farm category of qBittorrent, in GB. Nothing leaves the Farm under it. Once over it, ratio removes the C411 torrents that pay the least Zen for their size, among those that seeded at least RATIO_MIN_SEEDING_DAYS. Leave empty to use 100.
RATIO_MAX_SIZE_GB=

# Days a tracker torrent always seeds before ratio may remove it. Set it to the longest minimum seeding time among your private trackers, so a removal never counts as a hit and run.
RATIO_MIN_SEEDING_DAYS=

# Comma separated ids of the Prowlarr indexers ratio watches for fresh and Rare releases, private trackers only, for example 3. Leave empty to grab nothing.
RATIO_GRAB_INDEXER_IDS=

# Comma separated ids of the public Prowlarr indexers where ratio looks for a Twin, the same release byte for byte, to download it there for free, for example the id of Nyaa. Leave empty to always download from the private tracker.
RATIO_TWIN_INDEXER_IDS=

# Word of the announce URL that tells the torrents of the private tracker apart, for example c411. Leave empty to use c411.
RATIO_TRACKER=

# API key of the profile API of C411, scope profile:read, created in the settings of the C411 account. ratio reads the Account ratio with it once per run. Without it, ratio counts the Account ratio as under the floor and spends no download on C411. Treat it as a password.
C411_PROFILE_API_KEY=

# Ratio floor of the C411 account. Under it, or when the profile cannot be read, ratio spends no download on C411 and moves C411 onto the Paused sync profile of Prowlarr, so Radarr, Sonarr and Lidarr stop downloading from it. Seeding goes on, freeleech and Twins stay allowed. Leave empty to use 1.2.
RATIO_FLOOR=

# Paid download of the Volume hunt over the last 24 hours, in GB. The hunt also never spends past the Ratio floor. Leave empty to use 2.
RATIO_VOLUME_DAILY_GB=

# Webhook of the Farm channel of the Discord server dedicated to the NAS, where farm-report keeps one message per day with the Account tile and both parts of the board of ratio. Copy the webhook URL from Discord, https://discord.com/api/webhooks/<id>/<token>, and split it here. Anyone with both posts to the channel, so treat the token as a password.
DISCORD_FARM_WEBHOOK_ID=
DISCORD_FARM_WEBHOOK_TOKEN=

# Observation, optional with the beszel, uptime-kuma, autokuma and dozzle services

# Webhook of the alerts channel of the Discord server dedicated to the NAS, where backup, Beszel and Uptime Kuma send their alerts. Copy the webhook URL from Discord, https://discord.com/api/webhooks/<id>/<token>, and split it here. Anyone with both posts to the channel, so treat the token as a password.
DISCORD_ALERTS_WEBHOOK_ID=
DISCORD_ALERTS_WEBHOOK_TOKEN=

# Username and password of the admin account of Uptime Kuma, created in its web UI, which AutoKuma signs in with to write the checks. Treat the password as a password.
UPTIME_KUMA_USERNAME=
UPTIME_KUMA_PASSWORD=

# Email and password of the Beszel login, created at its first start. Treat the password as a password.
BESZEL_EMAIL=
BESZEL_PASSWORD=

# Public key the Beszel agent accepts the hub with, printed from the key Beszel creates at its first start, as the README sets out. It starts with ssh-ed25519 and holds a space, so wrap it in double quotes.
BESZEL_AGENT_KEY=

# Disk usage in percent over which Beszel sends an alert, for the data disk and the disk of Docker. Leave empty to use 85.
BESZEL_DISK_ALERT_PERCENT=

# Temperature in degrees Celsius over which Beszel sends an alert. Leave empty to use 80.
BESZEL_TEMPERATURE_ALERT_CELSIUS=

# Dashboard, optional with the homepage service

# Password of the Homepage login. Treat it as a password.
HOMEPAGE_PASSWORD=

# Secret Homepage signs its login cookies with, at least 32 characters. Generate one with: openssl rand -hex 32. Treat it as a password.
HOMEPAGE_AUTH_SECRET=

# API key Homepage reads qBittorrent with, generated in Tools > Options > WebUI > Authentication in qBittorrent. Treat it as a password.
QBITTORRENT_API_KEY=

# API key Homepage reads Jellyfin with, created in Jellyfin, Dashboard > API Keys. Treat it as a password.
JELLYFIN_API_KEY=

# API key Homepage reads Seerr with, copied from Settings > General in Seerr. Treat it as a password.
SEERR_API_KEY=

# API key Homepage reads Bazarr with, copied from Settings > General > Security in Bazarr. Treat it as a password.
BAZARR_API_KEY=

# API key Homepage reads autobrr with, created in Settings > API Keys in autobrr. Leave empty without the autobrr service. Treat it as a password.
AUTOBRR_API_KEY=
