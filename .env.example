# Copy this file to .env and fill in every value. Never commit .env.

# Time zone of the NAS, as a tz database name, for example Europe/Paris.
TZ=

# User and group ids the services run as. On Linux, run `id` to get yours (often 1000). On Windows with Docker Desktop, use 1000.
PUID=
PGID=

# Absolute path of the data root, outside the repo. It holds the torrents tree and the media tree (movies, shows, music, books). Use forward slashes, for example D:/nas/data on Windows or /srv/nas/data on Linux.
DATA_ROOT=

# Absolute path of the appdata root, outside the repo. Each service keeps its database and settings in its own folder here. Same format as DATA_ROOT.
APPDATA_ROOT=

# Port of the Jellyfin web UI on the local network. Leave empty to use 8096.
JELLYFIN_PORT=
