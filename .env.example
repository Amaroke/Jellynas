# Copy this file to .env and fill in every value. Never commit .env.

# Time zone of the NAS, as a tz database name, for example Europe/Paris.
TZ=

# User and group ids the services run as. On TrueNAS, use 568, the apps user. On another Linux host, run `id` to get yours (often 1000).
PUID=
PGID=

# Absolute path of the data root, outside the repo. It holds the torrents tree and the media tree (movies, shows, anime, music, books, manga). For example /mnt/tank/data on TrueNAS or /srv/nas/data on another Linux host.
DATA_ROOT=

# Absolute path of the appdata root, outside the repo. Each service keeps its database and settings in its own folder here. Same format as DATA_ROOT.
APPDATA_ROOT=

# Domain of the NAS, its DNS zone hosted by OVH. Friends reach jellyfin.<DOMAIN> and seerr.<DOMAIN>, the Admin reaches each tool at <tool>.lan.<DOMAIN> from the local network only.
DOMAIN=

# Local network allowed to reach the lan names, in CIDR notation, for example 192.168.1.0/24. Caddy refuses any other source.
LAN_SUBNET=

# OVH API endpoint of the account that holds the zone. Leave empty to use ovh-eu.
OVH_ENDPOINT=

# OVH API keys Caddy uses to obtain the certificates and to keep jellyfin and seerr on the public IP, created at https://eu.api.ovh.com/createToken/ with rights on the records of the zone only. Treat them as passwords.
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# HTTPS port of Caddy, the only port the NAS publishes, forwarded by the router with the same number. Leave empty to use 443. A high port no service uses by default draws fewer scans.
CADDY_HTTPS_PORT=

# VPN that every torrent goes through. Leave all VPN values empty until you choose a provider: Gluetun then keeps the tunnel down and qBittorrent has no connectivity. Provider name as listed by Gluetun, for example airvpn, protonvpn or mullvad.
VPN_SERVICE_PROVIDER=

# VPN protocol, wireguard or openvpn. Leave empty to use openvpn.
VPN_TYPE=

# OpenVPN username and password, given by the provider for manual setups. Not your website login with most providers. Treat the password as a password.
OPENVPN_USER=
OPENVPN_PASSWORD=

# WireGuard private key, preshared key and interface address, taken from a WireGuard config file generated by the provider. Only some providers, such as AirVPN, give a preshared key. Keep only the IPv4 address. Treat both keys as passwords.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=

# Comma separated countries of the VPN servers to use, for example Netherlands,Switzerland. Leave empty to let Gluetun pick.
SERVER_COUNTRIES=

# Comma separated regions of the VPN servers to use, for example Europe with AirVPN. Wider than countries. Leave empty to let Gluetun pick.
SERVER_REGIONS=

# Ports the VPN provider forwards to you, comma separated, so that peers can connect in. The first one is for qBittorrent. Leave empty if your provider gives none.
VPN_FORWARDED_PORT=

# API keys Recyclarr uses to sync the quality profiles, copied from Settings > General > Security in Radarr and in Sonarr. Treat them as passwords.
RADARR_API_KEY=
SONARR_API_KEY=

# API key the Tdarr node uses to talk to the Tdarr server. It is also the first password of the Tdarr admin Account, so set it before the first start. It starts with tapi_ followed by at least 10 letters, digits or underscores. Generate one with: echo "tapi_$(openssl rand -hex 16)". Treat it as a password.
TDARR_API_KEY=

# qBittorrent Account that cross-seed, qbit_manage and ratio-limit use to talk to qBittorrent, the one set in Tools > Options > WebUI. Treat the password as a password.
QBITTORRENT_USER=
QBITTORRENT_PASSWORD=

# API key that protects the cross-seed API, at least 24 characters. Generate one with: openssl rand -hex 24. Treat it as a password.
CROSS_SEED_API_KEY=

# API key cross-seed uses to search Prowlarr, copied from Settings > General > Security in Prowlarr. Treat it as a password.
PROWLARR_API_KEY=

# Comma separated ids of the Prowlarr indexers cross-seed searches, private trackers only, for example 3,7. The id is the number in the Torznab URL that Prowlarr shows for each indexer.
CROSS_SEED_INDEXER_IDS=

# Size limit of the ratio folder, /data/torrents/ratio, in GB. Once over it, ratio-limit removes the ratio torrents that upload the least, among those that seeded at least RATIO_MIN_SEEDING_DAYS.
RATIO_MAX_SIZE_GB=

# Days a ratio torrent always seeds before ratio-limit may remove it to free space. Set it to the longest minimum seeding time among your private trackers, so a removal never counts as a hit and run.
RATIO_MIN_SEEDING_DAYS=

# Comma separated ids of the Prowlarr indexers ratio-grab watches for fresh releases to seed in the ratio folder, private trackers only, for example 3. Leave empty to grab nothing.
RATIO_GRAB_INDEXER_IDS=

# Largest amount in GB that the ratio torrents may have downloaded beyond what they uploaded. Over it, ratio-grab grabs nothing until their upload pays it back. It keeps counting the torrents removed since, until its state file is deleted. 5 is a good start.
RATIO_GRAB_MAX_DEFICIT_GB=
