{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tests",
      "type": "process",
      "command": "python",
      "args": ["-m", "unittest"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "dependsOn": ["Lint: ruff", "Lint: yamllint", "Lint: markdownlint"],
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Lint: ruff",
      "type": "process",
      "command": "python",
      "args": ["-m", "ruff", "check", "."],
      "problemMatcher": []
    },
    {
      "label": "Lint: yamllint",
      "type": "process",
      "command": "python",
      "args": ["-m", "yamllint", "--strict", "."],
      "problemMatcher": []
    },
    {
      "label": "Lint: markdownlint",
      "type": "shell",
      "command": "npx --yes markdownlint-cli2@0.24.1 \"**/*.md\"",
      "problemMatcher": []
    },
    {
      "label": "NAS: verify",
      "type": "process",
      "command": "ssh",
      "args": [
        "-t",
        "${env:JELLYNAS_SSH}",
        "cd ${env:JELLYNAS_CLONE} && sudo git pull --ff-only && sudo ./scripts/verify.sh"
      ],
      "problemMatcher": []
    },
    {
      "label": "NAS: deploy now",
      "type": "process",
      "command": "ssh",
      "args": ["${env:JELLYNAS_SSH}", "sudo docker restart doco-cd"],
      "problemMatcher": []
    },
    {
      "label": "NAS: logs of a service",
      "type": "process",
      "command": "ssh",
      "args": [
        "-t",
        "${env:JELLYNAS_SSH}",
        "sudo docker logs --tail 200 --follow ${input:service}"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "service",
      "type": "promptString",
      "description": "Container name, for example radarr"
    }
  ]
}
