{
	https_port {$CADDY_HTTPS_PORT}
	auto_https disable_redirects
	acme_dns ovh {
		endpoint {env.OVH_ENDPOINT}
		application_key {env.OVH_APPLICATION_KEY}
		application_secret {env.OVH_APPLICATION_SECRET}
		consumer_key {env.OVH_CONSUMER_KEY}
	}
	dynamic_dns {
		provider ovh {
			endpoint {env.OVH_ENDPOINT}
			application_key {env.OVH_APPLICATION_KEY}
			application_secret {env.OVH_APPLICATION_SECRET}
			consumer_key {env.OVH_CONSUMER_KEY}
		}
		domains {
			{$DOMAIN} jellyfin seerr auth aurral kavita
		}
		versions ipv4
		check_interval 5m
	}
	servers {
		protocols h1 h2
	}
}

(lan) {
	@{args[0]} {
		host {args[0]}.lan.{$DOMAIN}
		remote_ip {$LAN_SUBNET}
	}
	handle @{args[0]} {
		reverse_proxy {args[1]} {
			header_down Location ^http:// https://
		}
	}
}

*.{$DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	@jellyfin host jellyfin.{$DOMAIN}
	handle @jellyfin {
		redir /go/kavita https://kavita.{$DOMAIN}:{$CADDY_HTTPS_PORT}
		redir /go/aurral https://aurral.{$DOMAIN}:{$CADDY_HTTPS_PORT}
		redir /go/seerr https://seerr.{$DOMAIN}:{$CADDY_HTTPS_PORT}
		reverse_proxy jellyfin:8096
	}
	@seerr host seerr.{$DOMAIN}
	handle @seerr {
		reverse_proxy seerr:5055
	}
	@auth host auth.{$DOMAIN}
	handle @auth {
		reverse_proxy authelia:9091
	}
	@aurral host aurral.{$DOMAIN}
	handle @aurral {
		reverse_proxy aurral:3001
	}
	@kavita host kavita.{$DOMAIN}
	handle @kavita {
		reverse_proxy kavita:5000
	}
	handle {
		abort
	}
}

*.lan.{$DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	import lan truenas host.docker.internal:80
	@jellyfinlinks {
		host jellyfin.lan.{$DOMAIN}
		remote_ip {$LAN_SUBNET}
		path /go/*
	}
	handle @jellyfinlinks {
		redir /go/kavita https://kavita.lan.{$DOMAIN}:{$CADDY_HTTPS_PORT}
		redir /go/aurral https://aurral.lan.{$DOMAIN}:{$CADDY_HTTPS_PORT}
		redir /go/seerr https://seerr.lan.{$DOMAIN}:{$CADDY_HTTPS_PORT}
	}
	import lan jellyfin jellyfin:8096
	import lan seerr seerr:5055
	import lan aurral aurral:3001
	import lan kavita kavita:5000
	import lan lldap lldap:17170
	@qbittorrent {
		host qbittorrent.lan.{$DOMAIN}
		remote_ip {$LAN_SUBNET}
	}
	handle @qbittorrent {
		reverse_proxy gluetun:8080 {
			header_up Host {upstream_hostport}
		}
	}
	import lan prowlarr prowlarr:9696
	import lan radarr radarr:7878
	import lan sonarr sonarr:8989
	import lan slskd gluetun:5030
	import lan lazylibrarian lazylibrarian:5299
	import lan bazarr bazarr:6767
	import lan tdarr tdarr:8265
	import lan autobrr autobrr:7474
	@actions {
		host actions.lan.{$DOMAIN}
		remote_ip {$LAN_SUBNET}
		path /actions*
	}
	handle @actions {
		reverse_proxy discord-posts:8000
	}
	@prs {
		host prs.lan.{$DOMAIN}
		remote_ip {$LAN_SUBNET}
		path /pulls
	}
	handle @prs {
		reverse_proxy pr-radar:8000
	}
	import lan beszel beszel:8090
	import lan uptime-kuma uptime-kuma:3001
	import lan dozzle dozzle:8080
	@homepage {
		host homepage.lan.{$DOMAIN}
		remote_ip {$LAN_SUBNET}
	}
	handle @homepage {
		redir https://dashboard.lan.{$DOMAIN}:{$CADDY_HTTPS_PORT}{uri}
	}
	import lan dashboard dashboard:8000
	handle {
		abort
	}
}

:{$CADDY_HTTPS_PORT} {
	abort
}
